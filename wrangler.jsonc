{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jet-brasilia-monitorvo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESERVAS",
        "class_name": "Reservas"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Reservas"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
